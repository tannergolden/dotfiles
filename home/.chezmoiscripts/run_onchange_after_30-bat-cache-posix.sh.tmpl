{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# --- Rebuild bat's theme cache when the vendored theme changes ---
#
# bat only sees a custom theme after `bat cache --build`. This script is
# keyed to the THEME FILE, not to itself: the hash below is interpolated
# from the vendored tmTheme, so editing the theme changes this script's
# rendered content, which is exactly what makes run_onchange_ fire.
#
# theme hash: {{ include "dot_config/bat/themes/Catppuccin Mocha.tmTheme" | sha256sum }}

set -euo pipefail

if [ "${CI_STUB:-0}" = "1" ]; then
  echo "CI_STUB=1: would rebuild the bat theme cache"
  exit 0
fi

# Debian installs the binary as batcat.
if command -v bat >/dev/null 2>&1; then
  bat cache --build >/dev/null && echo "==> bat theme cache rebuilt"
elif command -v batcat >/dev/null 2>&1; then
  batcat cache --build >/dev/null && echo "==> bat theme cache rebuilt"
else
  echo "bat not installed yet; theme cache will build on a later apply" >&2
fi
{{- end }}
