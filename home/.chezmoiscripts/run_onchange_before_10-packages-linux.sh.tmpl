{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# --- Provision Linux packages, including inside a Codespace ---
#
# apt cannot carry this toolchain alone. starship is not in the Ubuntu
# archive at all, and several of the others lag upstream far enough to
# matter. So apt supplies what it has and pinned upstream releases supply
# the rest.
#
# THE LINES BELOW ARE LOAD-BEARING, NOT NOTES. run_onchange_ records the
# hash of a script that exits 0 and does not run it again until its
# content changes - and the no-sudo branch exits 0. Interpolating these
# paths at render time makes the script's content change when the missing
# piece appears, so the apt stage re-fires by itself instead of being
# recorded as done-and-skipped forever.
#
# Residual limit, stated rather than papered over: a transient download
# failure inside a run still records success. Degrading rather than
# aborting is the house choice; this only heals the tool-absent case.
# sudo at render time: {{ lookPath "sudo" }}
# apt-get at render time: {{ lookPath "apt-get" }}

set -euo pipefail

if [ "${CI_STUB:-0}" = "1" ]; then
  echo "CI_STUB=1: would install {{ len .packages.linux.apt }} apt packages"
  exit 0
fi

# --- apt -------------------------------------------------------------------
if command -v apt-get >/dev/null 2>&1; then
  SUDO=""
  if [ "$(id -u)" -ne 0 ]; then
    if command -v sudo >/dev/null 2>&1; then
      SUDO="sudo"
    else
      echo "not root and no sudo; skipping apt packages" >&2
    fi
  fi

  if [ "$(id -u)" -eq 0 ] || [ -n "${SUDO}" ]; then
    echo "==> apt-get install ({{ len .packages.linux.apt }} packages)"
    export DEBIAN_FRONTEND=noninteractive
    ${SUDO} apt-get update -qq || true
    # One missing package must not take the rest with it, so install
    # individually and keep going.
    for pkg in {{ range .packages.linux.apt }}{{ . }} {{ end }}; do
      ${SUDO} apt-get install -y -qq "${pkg}" >/dev/null 2>&1 \
        || echo "  could not install ${pkg}, continuing" >&2
    done
  fi
else
  echo "no apt-get; skipping distribution packages" >&2
fi

# --- upstream releases -----------------------------------------------------
# Installed to a user-writable prefix so this works without root, which
# matters in a container where you may not have it.
BIN_DIR="${HOME}/.local/bin"
mkdir -p "${BIN_DIR}"

# MUSL ONLY. The gnu triple was set here too and never read by anything -
# both upstream tools below fetch the statically linked musl build, which
# is the point: it runs on any glibc vintage the container happens to
# have. Kept as one variable so nothing can drift back apart.
case "$(uname -m)" in
  x86_64|amd64) ARCH_MUSL="x86_64-unknown-linux-musl" ;;
  aarch64|arm64) ARCH_MUSL="aarch64-unknown-linux-musl" ;;
  *) echo "unknown architecture $(uname -m); skipping upstream tools" >&2; exit 0 ;;
esac

install_starship() {
  command -v starship >/dev/null 2>&1 && return 0
  echo "==> starship (upstream release)"
  local tmp; tmp="$(mktemp -d)"
  local url="https://github.com/starship/starship/releases/latest/download/starship-${ARCH_MUSL}.tar.gz"
  if curl -fsSL -o "${tmp}/s.tar.gz" "${url}" 2>/dev/null; then
    tar -xzf "${tmp}/s.tar.gz" -C "${tmp}" && install -m 0755 "${tmp}/starship" "${BIN_DIR}/starship"
  else
    echo "  starship download failed, continuing" >&2
  fi
  rm -rf "${tmp}"
}

install_zoxide() {
  command -v zoxide >/dev/null 2>&1 && return 0
  echo "==> zoxide (upstream release)"
  local tmp; tmp="$(mktemp -d)"
  # THE REDIRECT FIRST, THE REST API ONLY AS A FALLBACK. Unauthenticated
  # api.github.com allows 60 requests an hour PER IP, and a codespace, an
  # office or a CI runner shares one NAT address with everybody else on
  # it - so a 403 here is routine rather than exotic. It left `ver` empty,
  # skipped zoxide, and exited 0, which run_onchange records as done
  # forever. The /releases/latest web endpoint is a plain redirect whose
  # target carries the tag and is not rate limited, so it is tried first;
  # the old API call stays as a second chance for a network that allows
  # api.github.com but not the web host. Both are best effort, and a
  # GITHUB_TOKEN raises the API's limit when one exists (a codespace
  # always provides one).
  local ver
  ver="$(curl -fsSLI -o /dev/null -w '%{url_effective}' \
    https://github.com/ajeetdsouza/zoxide/releases/latest 2>/dev/null \
    | sed -n 's|.*/tag/v\(.*\)$|\1|p')" || ver=""
  if [ -z "${ver}" ]; then
    ver="$(curl -fsSL ${GITHUB_TOKEN:+-H "Authorization: Bearer ${GITHUB_TOKEN}"} \
      https://api.github.com/repos/ajeetdsouza/zoxide/releases/latest 2>/dev/null \
      | grep -m1 '"tag_name"' | sed 's/.*"v\([^"]*\)".*/\1/')" || ver=""
  fi
  if [ -n "${ver}" ]; then
    local url="https://github.com/ajeetdsouza/zoxide/releases/download/v${ver}/zoxide-${ver}-${ARCH_MUSL}.tar.gz"
    if curl -fsSL -o "${tmp}/z.tar.gz" "${url}" 2>/dev/null; then
      tar -xzf "${tmp}/z.tar.gz" -C "${tmp}" && install -m 0755 "${tmp}/zoxide" "${BIN_DIR}/zoxide"
    fi
  fi
  command -v "${BIN_DIR}/zoxide" >/dev/null 2>&1 || echo "  zoxide install failed, continuing" >&2
  rm -rf "${tmp}"
}

install_claude_code() {
  command -v claude >/dev/null 2>&1 && return 0
  # npm is the channel that could actually be verified from here: the
  # package is real, current, and declares `os: any` with a `claude` bin.
  # There is also a native install script, but both endpoints for it were
  # unreachable through the network this was developed behind, so it is
  # deliberately not used rather than cited unverified.
  if ! command -v npm >/dev/null 2>&1; then
    echo "  claude-code needs npm on Linux and node is not installed, skipping" >&2
    echo "  (a Codespace image normally provides node; a bare box may not)" >&2
    return 0
  fi
  echo "==> claude-code (npm)"
  # A user-level prefix, so this needs no root and cannot collide with a
  # distribution-managed node.
  npm install -g --prefix "${HOME}/.local" @anthropic-ai/claude-code >/dev/null 2>&1 \
    || echo "  claude-code install failed, continuing" >&2
}

install_antigravity_cli() {
  command -v antigravity >/dev/null 2>&1 && return 0
  echo "==> antigravity-cli (pinned upstream tarball)"
  # No package manager carries this on Linux, so the tarball is fetched
  # directly. The URL embeds a version AND a build id, both pinned in
  # .chezmoidata/packages.yaml so the version is reviewable in a diff
  # rather than buried in a script.
  local pin="{{ .pins.antigravityCli }}"
  local tarch; case "$(uname -m)" in
    x86_64|amd64) tarch="x64" ;;
    aarch64|arm64) tarch="arm64" ;;
    *) echo "  no antigravity-cli build for $(uname -m), skipping" >&2; return 0 ;;
  esac
  # The path component and the filename use DIFFERENT spellings of the
  # architecture on this host: the directory says x64 while the file says
  # x64 too, but arm uses "arm" in the path and "arm64" in the name.
  local dirarch; [ "${tarch}" = "x64" ] && dirarch="x64" || dirarch="arm"

  local tmp; tmp="$(mktemp -d)"
  local url="https://storage.googleapis.com/antigravity-public/antigravity-cli/${pin}/linux-${dirarch}/cli_linux_${tarch}.tar.gz"
  if curl -fsSL -o "${tmp}/ag.tar.gz" "${url}" 2>/dev/null; then
    tar -xzf "${tmp}/ag.tar.gz" -C "${tmp}"
    # The archive layout is not guaranteed stable, so find the binary
    # rather than assuming it sits at the root.
    local bin; bin="$(find "${tmp}" -type f -name 'antigravity*' -perm -u+x 2>/dev/null | head -1)"
    if [ -n "${bin}" ]; then
      install -m 0755 "${bin}" "${BIN_DIR}/antigravity"
    else
      echo "  antigravity binary not found in the archive, continuing" >&2
    fi
  else
    echo "  antigravity-cli download failed, continuing" >&2
  fi
  rm -rf "${tmp}"
}

install_fastfetch() {
  command -v fastfetch >/dev/null 2>&1 && return 0
  echo "==> fastfetch (upstream release)"
  # Ubuntu 24.04 has no fastfetch package (it enters the archive at
  # 25.10), so the release tarball is the route. It is genuinely
  # user-level: the binary finds its presets via ../share relative to
  # itself, so bin/ and share/ land under ~/.local and nothing needs root.
  local tarch; case "$(uname -m)" in
    x86_64|amd64) tarch="amd64" ;;
    aarch64|arm64) tarch="aarch64" ;;
    *) echo "  no fastfetch build for $(uname -m), skipping" >&2; return 0 ;;
  esac
  local tmp; tmp="$(mktemp -d)"
  local url="https://github.com/fastfetch-cli/fastfetch/releases/latest/download/fastfetch-linux-${tarch}.tar.gz"
  if curl -fsSL -o "${tmp}/ff.tar.gz" "${url}" 2>/dev/null \
     && tar -xzf "${tmp}/ff.tar.gz" -C "${tmp}"; then
    # Archive layout: fastfetch-linux-<arch>/usr/{bin,share}.
    local root="${tmp}/fastfetch-linux-${tarch}/usr"
    if [ -x "${root}/bin/fastfetch" ]; then
      install -m 0755 "${root}/bin/fastfetch" "${BIN_DIR}/fastfetch"
      mkdir -p "${HOME}/.local/share"
      rm -rf "${HOME}/.local/share/fastfetch"
      cp -R "${root}/share/fastfetch" "${HOME}/.local/share/fastfetch" 2>/dev/null \
        || echo "  fastfetch presets not copied; the binary still works" >&2
    else
      echo "  fastfetch binary not found in the archive, continuing" >&2
    fi
  else
    echo "  fastfetch download failed, continuing" >&2
  fi
  rm -rf "${tmp}"
}

install_ollama() {
  command -v ollama >/dev/null 2>&1 && return 0
  # A codespace is throwaway, its disk is 32GB, and this archive is
  # ~1.4GB with ~4GB unpacked - pulling that on every codespace creation
  # would tax creation time for a CPU-only model nobody asked for. Opt in
  # instead; the README documents the one-liner.
  if [ -n "${CODESPACES:-}" ] && [ "${AI_LOCAL_MODELS:-0}" != "1" ]; then
    echo "  codespace: skipping the ~1.4GB ollama runtime (set AI_LOCAL_MODELS=1 to opt in)" >&2
    return 0
  fi
  echo "==> ollama (upstream release, ~1.4GB)"
  # The official install script hard-requires root and wants systemd; the
  # release archive needs neither. It is .tar.zst - current releases ship
  # NO .tgz - hence zstd in the apt list. bin/ollama and lib/ollama must
  # stay siblings, which ~/.local provides.
  if ! command -v zstd >/dev/null 2>&1; then
    echo "  zstd is not installed and the ollama archive needs it, skipping" >&2
    return 0
  fi
  local tarch; case "$(uname -m)" in
    x86_64|amd64) tarch="amd64" ;;
    aarch64|arm64) tarch="arm64" ;;
    *) echo "  no ollama build for $(uname -m), skipping" >&2; return 0 ;;
  esac
  local url="https://github.com/ollama/ollama/releases/latest/download/ollama-linux-${tarch}.tar.zst"
  # STAGED THROUGH A TEMP DIR, NOT STREAMED INTO ~/.local. Streaming tar
  # straight into the destination means an interrupted download leaves a
  # truncated bin/ollama in place, and the `command -v` guard above then
  # reports it installed forever. Extract fully, verify the binary exists,
  # only then move into place.
  local tmp; tmp="$(mktemp -d)"
  if curl -fsSL "${url}" 2>/dev/null | zstd -d 2>/dev/null | tar -x -C "${tmp}" 2>/dev/null \
     && [ -x "${tmp}/bin/ollama" ]; then
    # bin/ollama and lib/ollama must stay siblings under one prefix.
    if [ -d "${tmp}/lib/ollama" ]; then
      mkdir -p "${HOME}/.local/lib"
      rm -rf "${HOME}/.local/lib/ollama"
      mv "${tmp}/lib/ollama" "${HOME}/.local/lib/ollama"
    fi
    install -m 0755 "${tmp}/bin/ollama" "${BIN_DIR}/ollama"
  else
    echo "  ollama download failed, continuing" >&2
  fi
  rm -rf "${tmp}"
}

# Dispatch by name. A `case` rather than constructing a function name from
# the data, because a hyphenated package name is not a legal shell
# identifier and `install_antigravity-cli` would be a parse error.
for tool in {{ range .packages.linux.upstream }}{{ . }} {{ end }}; do
  case "${tool}" in
    starship)        install_starship ;;
    zoxide)          install_zoxide ;;
    claude-code)     install_claude_code ;;
    antigravity-cli) install_antigravity_cli ;;
    fastfetch)       install_fastfetch ;;
    ollama)          install_ollama ;;
    *) echo "  no installer defined for '${tool}'; add one to this script" >&2 ;;
  esac
done
{{- end }}
