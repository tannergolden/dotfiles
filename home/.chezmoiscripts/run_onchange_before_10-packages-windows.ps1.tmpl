{{- if eq .chezmoi.os "windows" -}}
# --- Provision Windows packages ---
#
# scoop for everything that can install per-user, winget for the one
# package that insists on elevating.
#
# scoop refuses to run as administrator by design and installs under the
# user profile, so nothing here raises a UAC prompt except Git, which
# declares ElevationRequirement: elevatesSelf and would raise one however
# it was invoked.
#
# THE LINES BELOW ARE LOAD-BEARING, NOT NOTES. run_onchange_ records the
# hash of a script that exits 0 and does not run it again until its
# content changes. This script now installs scoop itself, so these cover
# the case where THAT failed and scoop or winget arrived out of band
# later: their paths change the rendered content, so the package stage
# re-fires by itself rather than staying recorded as done.
# scoop at render time: {{ lookPath "scoop" }}
# winget at render time: {{ lookPath "winget" }}

$ErrorActionPreference = 'Continue'

if ($env:CI_STUB -eq '1') {
    Write-Host "CI_STUB=1: would install {{ len .packages.windows.scoop }} scoop packages"
    exit 0
}

# --- scoop -----------------------------------------------------------------
# Installed here rather than reported missing: install is one command with
# zero input, and "install scoop yourself, then re-run" was two manual
# steps hiding inside a warning. The official installer is per-user, no
# UAC; it refuses an elevated console unless told otherwise, hence the
# -RunAsAdmin pass-through for the odd machine that runs everything
# elevated. The shims path is appended for THIS process because the
# installer's PATH edit only reaches shells started after it.
if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
    Write-Host "==> installing scoop (per-user, no UAC)"
    $isAdmin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()
               ).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
    try {
        if ($isAdmin) {
            Invoke-Expression "& {$(Invoke-RestMethod get.scoop.sh)} -RunAsAdmin"
        } else {
            Invoke-RestMethod get.scoop.sh | Invoke-Expression
        }
    } catch {
        Write-Warning "scoop install failed: $($_.Exception.Message)"
    }
    $shims = Join-Path $HOME 'scoop\shims'
    if ((Test-Path $shims) -and ($env:PATH -notlike "*$shims*")) {
        $env:PATH = "$shims;$env:PATH"
    }
}

if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
    Write-Warning "scoop is still unavailable; skipping per-user packages. This does not abort the rest of the apply."
} else {
    Write-Host "==> scoop install ({{ len .packages.windows.scoop }} packages)"
    {{ range .packages.windows.scoop -}}
    # scoop install on an already-installed package is a no-op.
    scoop install {{ . }} 2>$null | Out-Null
    {{ end }}
}

# --- winget ----------------------------------------------------------------
if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    Write-Warning "winget is not available; skipping {{ len .packages.windows.winget }} package(s)."
} else {
    {{ range .packages.windows.winget -}}
    Write-Host "==> winget install {{ . }}"
    # --exact so a partial identifier cannot match the wrong package.
    # Note the accept flags suppress winget's own prompts but NOT the UAC
    # dialog, so this stage is not fully unattended on Windows.
    winget install --exact --id {{ . }} --silent `
        --accept-package-agreements --accept-source-agreements 2>$null | Out-Null
    {{ end }}
}
{{- end }}
