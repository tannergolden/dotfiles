{{- if eq .chezmoi.os "windows" -}}
# --- Write a shim at the real $PROFILE ---
#
# THE PROBLEM THIS SOLVES.
#
# $PROFILE lives under Documents. OneDrive Known Folder Move can relocate
# Documents by group policy, silently, with notifications suppressed, so
# the path is not knowable in advance. chezmoi derives target paths
# literally from source filenames and has no target-path templating
# (issue #2273, open, parked under the v3 label), so it cannot follow.
#
# A hardcoded Documents path would therefore write to a stale location and
# report success, and the profile would simply never load.
#
# So: chezmoi owns the real profile at a path that never moves, and this
# script resolves the true location at RUN time and writes a one-line shim
# there. Redirection can then only ever break a regenerable one-liner.
#
# The shim covers PowerShell 7+ (Documents\PowerShell) and Windows
# PowerShell 5.1 (Documents\WindowsPowerShell), which are separate
# directories by design.

$ErrorActionPreference = 'Stop'

$realProfile = Join-Path $HOME '.config\powershell\profile.ps1'
if (-not (Test-Path $realProfile)) {
    Write-Warning "expected profile at $realProfile but it is missing; skipping shim"
    exit 0
}

# Resolve at run time. Do NOT assume "$HOME\Documents".
$documents = [Environment]::GetFolderPath('MyDocuments')
if ([string]::IsNullOrWhiteSpace($documents)) {
    Write-Warning "could not resolve the Documents folder; skipping shim"
    exit 0
}

$shimBody = @"
# Generated by chezmoi. Do not edit.
# The real profile is version controlled at the path below; this file only
# points at it, because Documents can be relocated by OneDrive policy.
. "`$HOME\.config\powershell\profile.ps1"
"@

foreach ($dir in @('PowerShell', 'WindowsPowerShell')) {
    $target = Join-Path $documents "$dir\profile.ps1"
    $parent = Split-Path $target -Parent
    if (-not (Test-Path $parent)) {
        New-Item -ItemType Directory -Path $parent -Force | Out-Null
    }

    # Idempotent: only write when the content differs, so re-applying does
    # not churn the file's timestamp.
    $existing = if (Test-Path $target) { Get-Content $target -Raw -ErrorAction SilentlyContinue } else { $null }
    if ($existing -ne $shimBody) {
        # -Encoding utf8 is deliberate. PowerShell's default redirection
        # produces UTF-16LE, which several tools in this setup cannot read.
        Set-Content -Path $target -Value $shimBody -Encoding utf8 -NoNewline
        Write-Host "==> wrote profile shim: $target"
    }
}

# --- execution policy ------------------------------------------------------
# The default on Windows 10 and 11 clients is Restricted, which blocks ALL
# script files including profiles. Without a change the profile above never
# runs, and nothing announces that.
#
# This only reports. Silently mutating a machine's persistent security
# policy from a public repository is not something a provisioning script
# should do unasked.
$policy = Get-ExecutionPolicy -Scope CurrentUser
if ($policy -in @('Restricted', 'Undefined')) {
    Write-Warning @"
Execution policy for CurrentUser is '$policy'.
Your PowerShell profile will NOT load until this changes. To fix:

    Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser

This is per-user and needs no administrator rights.
"@
}
{{- end }}
