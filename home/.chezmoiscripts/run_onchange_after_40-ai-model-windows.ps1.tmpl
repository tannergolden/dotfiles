{{- if eq .chezmoi.os "windows" -}}
# --- Choose and pull the local model, after the tools exist ---
#
# The Windows twin of the POSIX 40-ai-model script: all logic lives in the
# managed ai-model.ps1, this only decides whether to invoke it. Keyed to
# that script's content so editing the ladder re-fires selection on the
# next apply.
#
# ai-model hash: {{ include "dot_local/bin/ai-model.ps1" | sha256sum }}
#
# AND KEYED TO ollama ITSELF, for the reason the POSIX twin states: a
# legitimate exit-0 skip is recorded by run_onchange_ and never revisited,
# so ollama arriving later never triggered model selection. One apply of
# lag is expected, since lookPath runs before the packages script in the
# same run installs it.
# ollama at render time: {{ lookPath "ollama" }}

$ErrorActionPreference = 'Continue'

if ($env:CI_STUB -eq '1') {
    Write-Host 'CI_STUB=1: would choose and pull a local model'
    exit 0
}

# On a first bootstrap scoop has only just written its shims, and the
# environment chezmoi inherited may predate them - the same first-apply
# trap the POSIX twin guards against with ~/.local/bin.
$shims = Join-Path $HOME 'scoop\shims'
if ((Test-Path $shims) -and ($env:PATH -notlike "*$shims*")) {
    $env:PATH = "$shims;$env:PATH"
}

# Degrade, never abort: a machine where scoop has not delivered ollama yet
# still deserves a completed apply.
if (-not (Get-Command ollama -ErrorAction SilentlyContinue)) {
    Write-Warning 'ollama not installed; skipping local model selection'
    exit 0
}

# -Auto caps the unattended download (default 32GB); anything bigger is
# pulled by a person running `ai-model install` deliberately.
#
# try/catch, not just $LASTEXITCODE: ai-model.ps1 runs under its own
# $ErrorActionPreference = 'Stop' and reports failure by THROWING, and a
# throw from a script invoked with & propagates into this one - without
# the catch it would take the whole chezmoi apply down with it, which is
# exactly what "degrade, never abort" forbids.
try {
    & (Join-Path $HOME '.local\bin\ai-model.ps1') install -Auto
    if ($LASTEXITCODE -ne 0) {
        Write-Warning 'ai-model install reported errors; continuing'
    }
} catch {
    Write-Warning "ai-model install reported errors; continuing: $($_.Exception.Message)"
}
exit 0
{{- end }}
