#!/usr/bin/env bash
# --- ai-model: the strongest local model this machine can actually hold ---
#
# WHAT THIS IS. One script that owns the whole local-model decision: detect
# what the hardware can serve, pick the most capable open-weight model that
# fits, pull it, and hand an interactive chat to the dashboard. Provisioning
# calls `ai-model install --auto`; a person calls `ai-model install`; the
# dashboard's fourth pane is `ai-model chat`.
#
# BASH 3.2 ONLY, like every shell script in this repository. macOS ships
# bash 3.2.57 as /bin/bash and will not ship a GPLv3 bash.
#
# THE LADDER IS THE PRODUCT, and it is data, not code. Every tag and size
# below was verified against the ollama.com library on 2026-07-31 (default
# quantisation, sizes rounded UP to whole GB). The provisioning script is
# keyed to a hash of this file, so editing the ladder re-fires model
# selection on the next `chezmoi apply` - the same mechanism the package
# manifest uses.
#
# WHY "BUDGET", NOT "RAM". The number that decides what fits is not the
# memory in the machine, it is the memory the model server can actually
# use, and that differs by platform in ways that are documented, not
# guessed:
#
#   * Apple Silicon: Ollama budgets Metal's recommendedMaxWorkingSetSize
#     verbatim (verified in ollama's discover/gpu_info_darwin.m). macOS
#     caps GPU-wired memory at ~2/3 of unified memory on <=32GiB machines
#     and 3/4 above that, unless the user raised iogpu.wired_limit_mb -
#     which is why that sysctl is consulted FIRST.
#   * Discrete NVIDIA/AMD: VRAM is the full-speed budget. Ollama will
#     partially offload a too-big model to system RAM, but that is the
#     graceful-degradation path, not something to aim for.
#   * CPU-only (including Intel Macs and containers): the model shares
#     system RAM with everything else, so 3/4 of it is the honest budget.
#     Inside a container /proc/meminfo shows the HOST's memory, so the
#     cgroup limit is read too and the smaller number wins.
#
# A model is then chosen so its download leaves real headroom in the
# budget - between roughly 55% and 80% used, tier by tier. The headroom is
# not waste: current Ollama auto-scales context length with free memory,
# and the KV cache for a long context is measured in gigabytes. The tiers
# that run closest to 80% are hybrid-attention MoE models whose KV cache
# stays small by architecture, which is why they can.

set -euo pipefail

# Self-heal PATH before anything consults it. During a FIRST bootstrap the
# package stage has just unpacked ollama into ~/.local/bin, but the
# invoking environment predates that directory being on PATH - and a
# `command -v ollama` miss here would make provisioning record a clean
# skip that run_onchange then never revisits.
case ":${PATH}:" in
  *":${HOME}/.local/bin:"*) ;;
  *) PATH="${HOME}/.local/bin:${PATH}" ;;
esac

# --- the ladder ------------------------------------------------------------
# columns: minimum budget (GiB) | ollama tag | download size (GB, rounded up)
#
# Tag traps this table deliberately avoids, so nobody "fixes" it into them:
#   * gemma4:latest is the E4B EDGE model and is BIGGER on disk (9.6GB)
#     than gemma4:12b (7.6GB). The 12b is pulled explicitly.
#   * qwen3-next:80b has parallel instruct/thinking tag families and the
#     default is not documented; the thinking variant is named outright.
#   * Cloud tags (gpt-oss:120b-cloud, glm-5.x, kimi-k*, deepseek-v4-*...)
#     have no local weights at all and must never appear here.
#   * deepseek-r1 below :671b is a Qwen/Llama distill, not the real thing.
#
# Every tier winner carries the ollama "tools" capability badge, so the
# chat pane can be wired into agent workflows later.
AI_MODEL_LADDER='
115 qwen3.5:122b-a10b 81
90 gpt-oss:120b 65
64 qwen3-next:80b-a3b-thinking 50
44 qwen3.6:35b 24
28 glm-4.7-flash 19
20 gpt-oss:20b 14
12 gemma4:12b 8
9 qwen3.5:9b 7
6 qwen3.5:4b 4
4 qwen3:4b 3
0 qwen3:0.6b 1
'

# Unattended pulls are capped so that a first `chezmoi apply` on a 128GB
# machine does not silently begin an 81GB download. A person who wants the
# top tier runs `ai-model install` once, on purpose.
AUTO_MAX_GB="${AI_MODEL_AUTO_MAX_GB:-32}"

STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/ai-dash"
STATE_FILE="${STATE_DIR}/model"

log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m warn\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31merror\033[0m %s\n' "$*" >&2; exit 1; }

# --- hardware detection ----------------------------------------------------
# Prints "<kind> <budget-in-GiB>", e.g. "apple-silicon 48" or "nvidia 24".
detect_budget() {
  local ram_bytes vram_mib best v f mem_kib lim smi_out
  case "$(uname -s)" in
    Darwin)
      ram_bytes="$(sysctl -n hw.memsize)"
      # hw.optional.arm64 is 1 on Apple Silicon even under Rosetta and the
      # OID does not exist on Intel, which is why `uname -m` is not used:
      # a shell under Rosetta reports x86_64 on an M-series machine.
      if [ "$(sysctl -in hw.optional.arm64 2>/dev/null)" = "1" ]; then
        # A user-raised wired limit overrides the default fraction, and
        # Ollama sees the raised ceiling automatically. 0 means default.
        v="$(sysctl -in iogpu.wired_limit_mb 2>/dev/null || true)"
        if [ -n "${v}" ] && [ "${v}" -gt 0 ] 2>/dev/null; then
          echo "apple-silicon $(( v / 1024 ))"
          return 0
        fi
        if [ "${ram_bytes}" -gt 34359738368 ]; then
          echo "apple-silicon $(( ram_bytes * 3 / 4 / 1073741824 ))"
        else
          echo "apple-silicon $(( ram_bytes * 2 / 3 / 1073741824 ))"
        fi
        return 0
      fi
      # Intel Mac: Metal acceleration is Apple-Silicon-only in current
      # Ollama, so this is a CPU-only machine however good its GPU was.
      echo "cpu $(( ram_bytes * 3 / 4 / 1073741824 ))"
      ;;
    Linux)
      # NVIDIA first. One line per GPU, integer MiB. Mismatched multi-GPU
      # rigs take the LARGEST card rather than the sum: a single model
      # cannot run at full speed across cards of different sizes, so the
      # sum overpromises.
      #
      # TWO GUARDS, both earned. nvidia-smi prints its failure text
      # ("NVIDIA-SMI has failed because...") to STDOUT, so the exit code
      # is checked AND each line must be purely numeric - otherwise a
      # broken driver's error message gets its digits harvested into a
      # fictional VRAM budget.
      if command -v nvidia-smi >/dev/null 2>&1; then
        if smi_out="$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null)"; then
          best=0
          while IFS= read -r vram_mib; do
            vram_mib="$(printf '%s' "${vram_mib}" | tr -d '[:space:]\r')"
            case "${vram_mib}" in
              ''|*[!0-9]*) continue ;;
            esac
            if [ "${vram_mib}" -gt "${best}" ]; then
              best="${vram_mib}"
            fi
          done <<EOF
${smi_out}
EOF
          if [ "${best}" -gt 0 ]; then
            echo "nvidia $(( best / 1024 ))"
            return 0
          fi
        fi
      fi
      # AMD via the amdgpu driver's sysfs, which works without ROCm
      # userland. The 4GiB floor is deliberate: an APU reports its small
      # VRAM carve-out here, and treating that as the budget would pick a
      # toy model on a machine whose real budget is its RAM.
      best=0
      for f in /sys/class/drm/card*/device/mem_info_vram_total; do
        if [ -r "${f}" ]; then
          v="$(cat "${f}" 2>/dev/null || true)"
          if [ -n "${v}" ] && [ "${v}" -gt "${best}" ] 2>/dev/null; then
            best="${v}"
          fi
        fi
      done
      if [ "${best}" -ge 4294967296 ]; then
        echo "amd $(( best / 1073741824 ))"
        return 0
      fi
      # CPU-only. Inside a container /proc/meminfo reports the HOST, so
      # the cgroup limit (v2 then v1) is consulted and the smaller wins.
      mem_kib="$(awk '/^MemTotal:/{print $2}' /proc/meminfo)"
      ram_bytes=$(( mem_kib * 1024 ))
      if [ -r /sys/fs/cgroup/memory.max ]; then
        lim="$(cat /sys/fs/cgroup/memory.max 2>/dev/null || echo max)"
        if [ "${lim}" != "max" ] && [ "${lim}" -lt "${ram_bytes}" ] 2>/dev/null; then
          ram_bytes="${lim}"
        fi
      elif [ -r /sys/fs/cgroup/memory/memory.limit_in_bytes ]; then
        lim="$(cat /sys/fs/cgroup/memory/memory.limit_in_bytes 2>/dev/null || echo 0)"
        if [ "${lim}" -gt 0 ] && [ "${lim}" -lt "${ram_bytes}" ] 2>/dev/null; then
          ram_bytes="${lim}"
        fi
      fi
      echo "cpu $(( ram_bytes * 3 / 4 / 1073741824 ))"
      ;;
    *)
      echo "cpu 0"
      ;;
  esac
}

# --- ladder lookup ---------------------------------------------------------
# pick_tier BUDGET_GB MAX_SIZE_GB  ->  "tag size_gb"; MAX 0 means no cap.
pick_tier() {
  local budget="$1" max="$2" min tag size
  while read -r min tag size; do
    if [ -z "${min}" ]; then continue; fi
    if [ "${budget}" -ge "${min}" ]; then
      if [ "${max}" -gt 0 ] && [ "${size}" -gt "${max}" ]; then continue; fi
      printf '%s %s\n' "${tag}" "${size}"
      return 0
    fi
  done <<EOF
${AI_MODEL_LADDER}
EOF
  return 1
}

# --- ollama plumbing -------------------------------------------------------
# `ollama list`, `pull` and `run` all talk to the server, and only two of
# the three platforms auto-start it (the Windows and macOS APP installs;
# the brew formula and every Linux install do not). So the server is
# started here when it is not answering, as a background process whose log
# goes somewhere findable.
server_up() { ollama ps >/dev/null 2>&1; }

ensure_server() {
  if server_up; then return 0; fi
  mkdir -p "${STATE_DIR}"
  log "starting ollama serve (log: ${STATE_DIR}/ollama-serve.log)"
  nohup ollama serve >>"${STATE_DIR}/ollama-serve.log" 2>&1 &
  local i=0
  while [ "${i}" -lt 40 ]; do
    if server_up; then return 0; fi
    sleep 0.5
    i=$(( i + 1 ))
  done
  die "ollama server did not come up; see ${STATE_DIR}/ollama-serve.log"
}

# A bare model name lists as name:latest, so normalise before comparing.
normalise() {
  case "$1" in
    *:*) printf '%s' "$1" ;;
    *)   printf '%s:latest' "$1" ;;
  esac
}

model_installed() {
  ollama list 2>/dev/null | awk 'NR>1 {print $1}' | grep -Fxq "$(normalise "$1")"
}

# First ladder entry that is already pulled, best first. Used by `chat`
# when no explicit choice exists, so the pane always runs the strongest
# thing on disk rather than failing over a missing state file.
best_installed() {
  local have min tag size
  have="$(ollama list 2>/dev/null | awk 'NR>1 {print $1}')"
  if [ -z "${have}" ]; then return 1; fi
  while read -r min tag size; do
    if [ -z "${min}" ]; then continue; fi
    if printf '%s\n' "${have}" | grep -Fxq "$(normalise "${tag}")"; then
      printf '%s\n' "${tag}"
      return 0
    fi
  done <<EOF
${AI_MODEL_LADDER}
EOF
  # Nothing from the ladder, but something is installed - use the first.
  printf '%s\n' "${have}" | head -1
}

# --- disk preflight --------------------------------------------------------
# Ollama has NO free-space check of its own (verified in server/download.go:
# it preallocates and fails mid-pull), so out-of-disk surfaces as a broken
# download after gigabytes of traffic. Checked here instead, against the
# models directory, with 20% headroom over the download size.
disk_ok() {
  local size_gb="$1" dir free_kb need_kb
  dir="${OLLAMA_MODELS:-${HOME}/.ollama/models}"
  # df needs a path that exists; walk up until one does.
  while [ ! -d "${dir}" ] && [ "${dir}" != "/" ]; do
    dir="$(dirname "${dir}")"
  done
  free_kb="$(df -Pk "${dir}" 2>/dev/null | awk 'NR==2 {print $4}')"
  if [ -z "${free_kb}" ]; then
    warn "could not determine free disk space for ${dir}; continuing"
    return 0
  fi
  need_kb=$(( size_gb * 1024 * 1024 * 12 / 10 ))
  if [ "${free_kb}" -lt "${need_kb}" ]; then
    warn "need ~$(( need_kb / 1024 / 1024 ))GB free for a ${size_gb}GB model; only $(( free_kb / 1024 / 1024 ))GB available on ${dir}"
    return 1
  fi
  return 0
}

# --- subcommands -----------------------------------------------------------
cmd_install() {
  local auto=false
  if [ "${1:-}" = "--auto" ]; then auto=true; fi

  command -v ollama >/dev/null 2>&1 \
    || die "ollama is not installed; run 'chezmoi apply' (or see the README for the container route)"

  local kind budget picked tag size cap
  read -r kind budget <<EOF
$(detect_budget)
EOF

  if [ -n "${AI_MODEL:-}" ]; then
    # An explicit override skips the ladder entirely. Size unknown, so the
    # disk preflight is skipped too - the override is a deliberate act.
    tag="${AI_MODEL}"
    size=0
    log "AI_MODEL=${tag} overrides the ladder"
  else
    if [ "${budget}" -le 0 ]; then die "could not detect usable memory"; fi
    cap=0
    if [ "${auto}" = "true" ]; then cap="${AUTO_MAX_GB}"; fi
    if [ -n "${AI_MODEL_MAX_GB:-}" ] \
       && { [ "${cap}" -eq 0 ] || [ "${AI_MODEL_MAX_GB}" -lt "${cap}" ]; }; then
      cap="${AI_MODEL_MAX_GB}"
    fi
    picked="$(pick_tier "${budget}" "${cap}")" \
      || die "no model fits a ${budget}GB budget under a ${cap}GB cap"
    read -r tag size <<EOF
${picked}
EOF
    log "detected ${kind}, usable model memory ~${budget}GB -> ${tag} (~${size}GB download)"
    # Say out loud when the cap held something back, and how to get it.
    if [ "${cap}" -gt 0 ]; then
      local full full_tag full_size
      if full="$(pick_tier "${budget}" 0)"; then
        read -r full_tag full_size <<EOF
${full}
EOF
        if [ "${full_tag}" != "${tag}" ]; then
          log "this machine could hold ${full_tag} (~${full_size}GB); run 'ai-model install' by hand to pull it"
        fi
      fi
    fi
  fi

  ensure_server

  if model_installed "${tag}"; then
    log "${tag} is already installed"
  else
    if [ "${size}" -gt 0 ] && ! disk_ok "${size}"; then
      die "not enough disk for ${tag}; free some space or set OLLAMA_MODELS to a bigger volume"
    fi
    log "pulling ${tag} (interrupted pulls resume; re-run to continue)"
    ollama pull "${tag}" || die "pull failed for ${tag}"
  fi

  mkdir -p "${STATE_DIR}"
  printf '%s\n' "${tag}" > "${STATE_FILE}"
  log "default model recorded in ${STATE_FILE}"
}

cmd_chat() {
  command -v ollama >/dev/null 2>&1 || {
    warn "ollama is not installed, so there is no local model to chat with"
    printf 'Install it (chezmoi apply installs it outside containers), then run: ai-model install\n'
    return 0
  }
  ensure_server
  local tag=""
  if [ -n "${AI_MODEL:-}" ]; then
    tag="${AI_MODEL}"
  elif [ -r "${STATE_FILE}" ]; then
    tag="$(head -1 "${STATE_FILE}")"
  fi
  if [ -n "${tag}" ] && ! model_installed "${tag}"; then
    warn "${tag} is not installed; falling back to the best installed model"
    tag=""
  fi
  if [ -z "${tag}" ]; then
    tag="$(best_installed || true)"
  fi
  if [ -z "${tag}" ]; then
    warn "no local model installed yet"
    printf 'Run: ai-model install\n'
    return 0
  fi
  log "chatting with ${tag} (exit with /bye or Ctrl+D)"
  exec ollama run "${tag}"
}

cmd_status() {
  local kind budget picked tag size
  read -r kind budget <<EOF
$(detect_budget)
EOF
  printf 'hardware        %s\n' "${kind}"
  printf 'model budget    ~%sGB\n' "${budget}"
  if picked="$(pick_tier "${budget}" 0)"; then
    read -r tag size <<EOF
${picked}
EOF
    printf 'ladder choice   %s (~%sGB download)\n' "${tag}" "${size}"
  else
    printf 'ladder choice   none\n'
  fi
  if [ -r "${STATE_FILE}" ]; then
    printf 'default model   %s\n' "$(head -1 "${STATE_FILE}")"
  else
    printf 'default model   not set (run: ai-model install)\n'
  fi
  if ! command -v ollama >/dev/null 2>&1; then
    printf 'ollama          not installed\n'
  elif ! server_up; then
    printf 'ollama          installed, server not running\n'
  else
    printf 'ollama          serving\n'
    ollama list 2>/dev/null | awk 'NR>1 {print "  installed     " $1 "  " $3 " " $4}'
  fi
}

usage() {
  cat <<'EOF'
usage: ai-model [status|install [--auto]|chat]

  status    Show detected hardware, the ladder's choice, and what is installed
  install   Pick the strongest model that fits and pull it
            --auto  never prompt-worthy sizes: cap the download at
                    AI_MODEL_AUTO_MAX_GB (default 32) for unattended runs
  chat      Interactive chat with the default model (the dashboard pane)

environment:
  AI_MODEL              force a specific ollama tag, skipping the ladder
  AI_MODEL_MAX_GB       cap the download size the ladder may choose
  AI_MODEL_AUTO_MAX_GB  the --auto cap (default 32)
  OLLAMA_MODELS         where models are stored (also where disk is checked)
EOF
}

case "${1:-status}" in
  status)  cmd_status ;;
  install) shift; cmd_install "$@" ;;
  chat)    cmd_chat ;;
  -h|--help|help) usage ;;
  *) usage; exit 2 ;;
esac
